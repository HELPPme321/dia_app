# Copy to .env and fill in values locally. Never commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# The client ID is public configuration; never put a client secret in browser code.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# SQLite database path. The server creates the directory and file when needed.
DATABASE_PATH=./data/dia.sqlite

# Used only by npm run admin:provision. Keep real values in the private local .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo accounts are NEVER seeded automatically. For a local development setup only,
# run "npm.cmd run demo:setup" to generate random credentials in your ignored .env.
# Never enable or seed demo accounts in production. Use "npm.cmd run demo:disable" to disable them.
ENABLE_DEMO_ACCOUNTS=false
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=
DEMO_ADMIN_EMAIL=admin.demo@example.test
DEMO_ADMIN_PASSWORD=
